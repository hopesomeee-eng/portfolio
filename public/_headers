# Cloudflare Pages Headers Configuration

# Aggressively cache immutable assets (JS, CSS, images with hashes) for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache favicon and resume for 1 week
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/resume.pdf
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Do NOT aggressively cache HTML and Service Workers (ensure users always get the latest version)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
